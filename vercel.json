{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vs-hub-1.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://vs-hub-1.onrender.com/uploads/$1"
    },
    {
      "source": "/s/(.*)",
      "destination": "https://vs-hub-1.onrender.com/s/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
